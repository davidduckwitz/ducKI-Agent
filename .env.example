# DucKI Node - AI Coding Agent

# LLM Provider Configuration
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=lmstudio-community/Meta-Llama-3-8B-Instruct-GGUF

OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-3-5-sonnet

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

CLAUDE_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-3-5-sonnet-20241022

NOUS_API_KEY=your_nous_api_key_here
NOUS_BASE_URL=https://api.nousresearch.com/v1
NOUS_MODEL=nous-hermes-2-mixtral-8x7b-dpo

# Default Provider (lmstudio | openrouter | openai | ollama | claude | nous)
DEFAULT_PROVIDER=lmstudio

# Server Configuration
PORT=3001
HOST=127.0.0.1
NODE_ENV=development

# Frontend Configuration
# VITE_PORT=5173  # Frontend dev server port (defaults to 5173, auto-increments if busy)

# Database
DATABASE_PATH=./storage/ducki.db

# Storage Paths
STORAGE_PATH=./storage
PROJECTS_PATH=./projects
# Optional override. Defaults to ~/DucKI/plugins and ~/DucKI/skills.
# DUCKI_HOME=C:/Users/<user>/DucKI
# DUCKI_PLUGINS_DIR=C:/Users/<user>/DucKI/plugins
# SKILLS_PATH=C:/Users/<user>/DucKI/skills

# Logging (debug|info|warn|error). "warn" keeps the terminal/log file quiet during normal
# operation; the CLI's own quiet-mode buffer still surfaces recent debug context on failure.
LOG_LEVEL=warn
# Uncomment to also persist logs to a file (adds a synchronous disk write per log line):
# LOG_FILE=./storage/logs/ducki.log

# Agent Configuration
AGENT_MAX_ITERATIONS=50
AGENT_TIMEOUT_MS=300000

# MCP Configuration
MCP_SERVER_URL=http://localhost:3002

# Local Speech-to-Text (offline, no external provider)
# Example whisper.cpp:
# LOCAL_STT_COMMAND=whisper-cli
# LOCAL_STT_ARGS=-m C:/models/ggml-base.en.bin -f {input}
#
# Placeholders:
# {input}  -> temporary audio file path
# {output} -> temporary output text file path (use this if your CLI writes files)
LOCAL_STT_COMMAND=C:/tools/whispercpp/whisper-cli.exe
LOCAL_STT_ARGS=-m C:/tools/whispercpp/models/ggml-base.bin -f {input} -otxt -of {outputBase} -l de
LOCAL_STT_INPUT_EXT=ogg
LOCAL_STT_TIMEOUT_MS=180000

DISCORD_VOICE_STT_PROVIDER=local
DISCORD_VOICE_STT_COMMAND=C:/tools/whispercpp/whisper-cli.exe
DISCORD_VOICE_STT_ARGS=-m C:/tools/whispercpp/models/ggml-base.bin -f {input} -otxt -of {outputBase} -l de
DISCORD_VOICE_STT_TIMEOUT_MS=180000

# Speech-to-Text Provider Default
# openai | ollama | silero | local | nodejs-whisper
DEFAULT_SPEECH_TO_TEXT_PROVIDER=local

# nodejs-whisper settings (if DISCORD_VOICE_STT_PROVIDER=nodejs-whisper)
NODEJS_WHISPER_MODEL_NAME=base
NODEJS_WHISPER_MODEL_ROOT_PATH=
NODEJS_WHISPER_AUTO_DOWNLOAD=true
NODEJS_WHISPER_USE_CUDA=false
NODEJS_WHISPER_LANGUAGE=de
NODEJS_WHISPER_TIMEOUT_MS=180000
NODEJS_WHISPER_INPUT_EXT=ogg
# ── Coding agent ────────────────────────────────────────────────────────────
# Type-check every file the coding agent writes, immediately after the write, instead of
# only at the end of an attempt via the full build. On by default; set to 0 to disable.
DUCKI_CODING_AUTO_DIAGNOSTICS=1
# Optional cheap model for the coding agent's read-only `explore` sub-agent. Exploration is
# the most call-heavy phase of a run and needs instruction-following, not deep reasoning, so
# a small model here cuts cost substantially. Unset = use the main model.
# DUCKI_EXPLORE_MODEL=anthropic/claude-haiku-4.5
# DUCKI_EXPLORE_PROVIDER=openrouter
