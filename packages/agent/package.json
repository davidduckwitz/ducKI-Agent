{
  "name": "@ducki/agent",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@ducki/database": "workspace:*",
    "@ducki/logger": "workspace:*",
    "@ducki/providers": "workspace:*",
    "@ducki/shared": "workspace:*",
    "@ducki/tools": "workspace:*",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "jsonrepair": "^3.15.0",
    "pdf-parse": "1.1.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
