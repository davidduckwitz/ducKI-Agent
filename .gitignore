# Dependencies & build output
node_modules/
dist/
build/
out/
*.tsbuildinfo
.turbo/
.vite/
# Vite config is source-only (apps/web/vite.config.ts). A compiled .js next to it would
# shadow the .ts (Vite resolves .js first) and silently drop config changes like the
# /socket.io proxy; the build no longer emits it (tsconfig.node.json).
vite.config.js
vite.config.d.ts
# Vite temp bundles created when a TS config is loaded
vite.config.*.timestamp-*.mjs
.cache/
coverage/

# Runtime data (plugin databases, lock/state files - not source)
*.db
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal
apps/server/plugins/*
apps/server/plugins/*/data/*
storage/
*.log

# Env & secrets
.env
.env.local
.env.*.local

# Editor / backup / OS cruft
*.bak
*.tmp
*.swp
*.swo
.DS_Store
Thumbs.db
.idea/

# Packaged binaries / installers (never belong in source control)
*.exe
*.zip
*.msi
*.dmg
*.sqlite

apps/server/shared-workspace/*
apps/server/dist/
apps/server/.plugin-staging/*
# Tauri
target/
apps/tauri-desktop/target/
apps/tauri-desktop/src-tauri/target/
apps/tauri-desktop/dist/
apps/tauri-server/target/
apps/tauri-server/src-tauri/target/
apps/tauri-server/dist/
Cargo.lock
apps/server/plugins/notes/data/notes.sqlite
apps/server/plugins/news/data/news.sqlite-wal
apps/server/plugins/.state.json
