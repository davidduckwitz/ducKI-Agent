{
  "productName": "DucKI UI",
  "version": "0.1.0",
  "identifier": "de.davidduckwitz.ducki-ui",
  "build": {
    "beforeBuildCommand": "node build.js",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DucKI UI",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "theme": "Dark",
        "backgroundColor": "#080b14",
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "wix": null
    }
  }
}
