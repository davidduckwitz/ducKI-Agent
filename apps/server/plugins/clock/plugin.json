{
  "name": "clock",
  "version": "1.0.0",
  "description": "Zeigt Uhrzeit, Datum und Wochentag als kleines Widget in Sidebar und Dashboard.",
  "author": "DucKI",
  "license": "Proprietary",
  "icon": "🕐",
  "category": "overview",
  "provides": {
    "widgets": [
      {
        "id": "top-clock",
        "page": "widget/index.html",
        "placement": "sidebar-before-mode",
        "align": "full",
        "frame": "borderless",
        "background": "transparent",
        "height": 85,
        "width": "sm"
      },
      {
        "id": "footer-clock",
        "page": "widget/index.html",
        "placement": "footer",
        "align": "right",
        "frame": "borderless",
        "background": "transparent",
        "height": 26,
        "width": "sm"
      },
      {
        "id": "dashboard-clock",
        "page": "widget/index.html",
        "placement": "dashboard",
        "align": "full",
        "frame": "card",
        "background": "transparent",
        "height": 150,
        "width": "full",
        "title": "Uhrzeit"
      }
    ]
  },
  "trust": "sandboxed",
  "enabled": true
}
