{
  "name": "homeassistant",
  "version": "1.1.0",
  "description": "Home Assistant Integration: Räume, Lichter, Fernseher, Wetter und andere Geräte natürlichsprachlich abfragen und sicher steuern. Mit Dashboard, Widgets und Offline-Zustandscache.",
  "author": "DucKI",
  "license": "Proprietary",
  "icon": "🏠",
  "category": "automation",
  "provides": {
    "moduleTools": [
      "tools/homeassistant.js"
    ],
    "skills": [
      "skills/homeassistant-usage"
    ],
    "settings": [
      {
        "key": "base_url",
        "type": "string",
        "description": "Home Assistant Basis-URL, z. B. http://homeassistant.local:8123 (ohne abschließenden Slash)",
        "required": true
      },
      {
        "key": "access_token",
        "type": "secret",
        "description": "Long-Lived Access Token aus dem Home-Assistant-Benutzerprofil (Profil → Sicherheit → Langlebige Zugriffstoken)",
        "required": true
      }
    ],
    "settingsPage": "settings/index.html",
    "frontendPage": "app/index.html",
    "widgets": [
      {
        "id": "weather",
        "page": "widgets/weather/index.html",
        "placement": "dashboard",
        "align": "full",
        "frame": "card",
        "background": "transparent",
        "height": 190,
        "width": "full",
        "title": "Wetter"
      },
      {
        "id": "lights",
        "page": "widgets/lights/index.html",
        "placement": "sidebar-after-mode",
        "align": "full",
        "frame": "card",
        "background": "transparent",
        "height": 100,
        "width": "full",
        "title": "Lichter"
      },
      {
        "id": "media",
        "page": "widgets/media/index.html",
        "placement": "sidebar-after-mode",
        "align": "full",
        "frame": "card",
        "background": "transparent",
        "height": 100,
        "width": "full",
        "title": "Fernseher & Medien"
      }
    ]
  },
  "storage": {
    "sqlite": true
  },
  "trust": "node",
  "permissions": [],
  "enabled": true
}
