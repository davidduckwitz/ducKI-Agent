{
  "name": "calendar",
  "version": "2.0.0",
  "description": "Persistenter Kalender mit Terminen in einer plugin-eigenen SQLite-Datenbank (getrennt von der Hauptdatenbank). Eigene Frontend-Seite (FullCalendar), Widget mit den nächsten Terminen und ein Tool, mit dem der Agent Termine anlegen, lesen, ändern und löschen kann.",
  "author": "DucKI",
  "license": "Proprietary",
  "icon": "📅",
  "category": "knowledge",
  "provides": {
    "scriptTools": [
      "tools/calendar.tool.json"
    ],
    "skills": [
      "skills/calendar-usage"
    ],
    "settings": [
      {
        "key": "default_view",
        "default": "dayGridMonth",
        "type": "select",
        "description": "Standard-Ansicht beim Öffnen des Kalenders",
        "options": [
          "dayGridMonth",
          "timeGridWeek",
          "timeGridDay",
          "listWeek",
          "multiMonthYear"
        ]
      },
      {
        "key": "default_category",
        "default": "work",
        "type": "select",
        "description": "Vorausgewählte Kategorie für neue Termine",
        "options": [
          "work",
          "private",
          "important"
        ]
      },
      {
        "key": "week_starts_monday",
        "default": true,
        "type": "boolean",
        "description": "Woche beginnt am Montag (statt Sonntag)"
      }
    ],
    "settingsPage": "settings/index.html",
    "frontendPage": "app/index.html",
    "widgets": [
      {
        "id": "sidebar-upcoming",
        "page": "widget/index.html",
        "placement": "sidebar-after-mode",
        "align": "full",
        "frame": "borderless",
        "background": "transparent",
        "height": 150,
        "width": "full"
      },
      {
        "id": "dashboard-calendar",
        "page": "widget/index.html",
        "placement": "dashboard",
        "align": "full",
        "frame": "borderless",
        "background": "transparent",
        "height": 180,
        "width": "full",
        "title": "Nächste Termine"
      }
    ]
  },
  "storage": {
    "sqlite": true
  },
  "trust": "sandboxed",
  "enabled": true
}
