* {n  margin: 0;n  padding: 0;n  box-sizing: border-box;
}

body {n  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;n  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);n  min-height: 100vh;n  display: flex;n  justify-content: center;n  align-items: center;n  padding: 20px;
}

.container {n  background: rgba(255, 255, 255, 0.95);n  border-radius: 25px;n  padding: 50px;n  box-shadow: 0 25px 80px rgba(0, 0, 0, 0.25);n  text-align: center;n  min-width: 380px;n  backdrop-filter: blur(10px);
}

h1 {n  font-size: 32px;n  color: #333;n  margin-bottom: 35px;n  font-weight: 700;n  letter-spacing: -0.5px;
}

.clock-display {n  background: linear-gradient(135deg, #f5f7fa 0%, #f0f4f8 100%);n  border-radius: 20px;n  padding: 40px;n  margin-bottom: 30px;n  box-shadow: inset 0 4px 12px rgba(0, 0, 0, 0.05);
}

.time {n  font-size: 72px;n  font-weight: 700;n  color: #667eea;n  font-family: 'JetBrains Mono', 'Courier New', monospace;n  letter-spacing: 3px;n  line-height: 1.1;n  animation: pulse 1s ease-in-out infinite;
}

@keyframes pulse {n  0%, 100% { opacity: 1; }n  50% { opacity: 0.95; }
}

.date-display {n  background: linear-gradient(135deg, #f9fafb 0%, #f3f4f6 100%);n  border-radius: 20px;n  padding: 25px;n  box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.03);
}

.day {n  font-size: 22px;n  color: #555;n  margin-bottom: 8px;n  font-weight: 600;n  text-transform: capitalize;
}

.date {n  font-size: 16px;n  color: #999;n  font-weight: 500;n  letter-spacing: 0.5px;
}

