{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the DucKI Node main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:tray:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-close",
    "notification:default",
    "shell:allow-open",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/node",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
