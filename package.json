{
  "name": "ducki-node",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node dev.js",
    "build": "pnpm -r run build",
    "build:web": "pnpm --filter @ducki/web run build",
    "build:server": "pnpm --filter @ducki/server run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r run clean",
    "whisper:build": "node scripts/build-whisper.js",
    "electron:dev": "concurrently \"pnpm dev\" \"wait-on http://localhost:5173 && pnpm --filter @ducki/desktop run dev\"",
    "electron:build": "pnpm build:web && pnpm build:server && pnpm --filter @ducki/desktop run dist"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0",
    "wait-on": "^7.2.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
