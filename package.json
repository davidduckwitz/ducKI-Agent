{
  "name": "ducki-node",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node dev.js",
    "build": "pnpm -r --filter=!@ducki/tauri-desktop --filter=!@ducki/tauri-server run build",
    "build:web": "pnpm --filter @ducki/web run build",
    "build:server": "pnpm --filter @ducki/server run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r run clean",
    "whisper:build": "node scripts/build-whisper.js",
    "electron:dev": "concurrently \"pnpm dev\" \"wait-on http://localhost:5173 && pnpm --filter @ducki/desktop run dev\"",
    "electron:build": "pnpm build:web && pnpm build:server && pnpm --filter @ducki/desktop run dist",
    "tauri:dev": "pnpm --filter @ducki/tauri-desktop run dev",
    "tauri:build": "pnpm --filter @ducki/tauri-desktop run dist",
    "tauri:server:dev": "pnpm --filter @ducki/tauri-server run dev",
    "tauri:server:build": "pnpm --filter @ducki/tauri-server run dist",
    "tauri:all:dev": "concurrently \"pnpm dev\" \"pnpm tauri:server:dev\" \"wait-on http://localhost:5173 && pnpm tauri:dev\"",
    "tauri:dev:no-server": "concurrently \"pnpm build:web\" \"pnpm tauri:server:dev\" \"wait-on http://localhost:3001 http://localhost:3002 && pnpm tauri:dev\""
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0",
    "wait-on": "^7.2.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "bip32": "^5.0.1",
    "bip39": "^3.1.0",
    "bitcoinjs-lib": "^7.0.1",
    "ethers": "^6.17.0",
    "qrcode": "^1.5.4",
    "recharts": "^3.10.1",
    "solana": "^3.0.0",
    "tiny-secp256k1": "^2.2.4",
    "web3": "^4.16.0",
    "xrpl": "^5.0.0"
  }
}
