{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ducki-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "ducki-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@ducki/web", "dev"],
      "port": 5174,
      "autoPort": true
    },
    {
      "name": "ducki-voice",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "../ducki-voice", "run", "dev"],
      "port": 5180
    },
    {
      "name": "erpel",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@ducki/erpel", "dev"],
      "port": 5188,
      "autoPort": true
    }
  ]
}
